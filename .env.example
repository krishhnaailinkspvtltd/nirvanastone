# ── Site identity ────────────────────────────────────────────────
# TODO(client): replace placeholder brand values in src/config/site.ts too.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (optional in dev — falls back to local JSON order store) ──
# Create a project at supabase.com, run supabase/schema.sql, then fill these in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay (optional in dev — checkout offers COD + a simulated card flow) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI recommender (optional — falls back to a rule-based matcher) ──
ANTHROPIC_API_KEY=

# ── n8n / WhatsApp automation (optional — events are logged when unset) ──
# Order lifecycle events are POSTed to {N8N_WEBHOOK_BASE_URL}/{event-name}
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_TOKEN=

# ── Dev helpers ──
# Shows the "PLACEHOLDER" corner tag on generated product imagery. Set to "false"
# for client-facing screenshots; real photos make this irrelevant.
NEXT_PUBLIC_SHOW_PLACEHOLDER_TAG=true
